        </mxCell>

        <mxCell id="stream" value="&lt;b&gt;STREAM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;compressão e envio do áudio&lt;br&gt;em pacotes RTP/UDP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
