        <mxCell id="contB" value="Detalhe de STREAM (transmissão do áudio)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#d79b00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;arcSize=4;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="430" width="1160" height="170" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="&lt;b&gt;1. Comprimir&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;ffmpeg → IMA ADPCM&lt;br&gt;(4 bits por amostra)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="480" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;2. Montar pacotes RTP&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;blocos de 160 amostras (20 ms)&lt;br&gt;cabeçalho com timestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="325" y="480" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;3. Enviar por UDP&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;1 pacote a cada 20 ms&lt;br&gt;(ritmo de tempo real)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="605" y="480" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;4. Fim do áudio&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;marker bit no último pacote&lt;br&gt;registra o envio e volta a MONITORAR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="885" y="480" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="eb1" value="" style="endArrow=classic;html=1;strokeWidth=1.5;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb2" value="" style="endArrow=classic;html=1;strokeWidth=1.5;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb3" value="" style="endArrow=classic;html=1;strokeWidth=1.5;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
