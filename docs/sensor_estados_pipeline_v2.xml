        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;5. Decisão&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;p_mosquito ≥ p_não-mosquito?&lt;br&gt;sim → STREAM · não → captura&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="965" y="280" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ea1" value="" style="endArrow=classic;html=1;strokeWidth=1.5;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea2" value="" style="endArrow=classic;html=1;strokeWidth=1.5;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea3" value="" style="endArrow=classic;html=1;strokeWidth=1.5;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea4" value="" style="endArrow=classic;html=1;strokeWidth=1.5;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>

