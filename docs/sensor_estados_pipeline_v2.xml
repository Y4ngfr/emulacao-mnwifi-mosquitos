        </mxCell>

        <mxCell id="mon" value="&lt;b&gt;MONITORAR&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;captura, ruído e inferência&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
