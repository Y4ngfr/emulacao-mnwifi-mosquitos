        <mxCell id="init" value="&lt;b&gt;INICIALIZAÇÃO&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;conecta ao broker (MQTT)&lt;br&gt;e aguarda o comando de início&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
