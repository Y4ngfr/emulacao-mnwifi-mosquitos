        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;2. Ruído gaussiano&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;SNR definida&lt;br&gt;pelo cenário (dB)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
