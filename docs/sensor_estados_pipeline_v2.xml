        <mxCell id="e_det" value="mosquito detectado" style="endArrow=classic;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="mon" target="stream">
