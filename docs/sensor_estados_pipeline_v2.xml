        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;3. Espectrograma Mel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;áudio de 8 kHz&lt;br&gt;convertido em imagem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="505" y="280" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;4. CNN embarcada&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;modelo quantizado (int8)&lt;br&gt;probabilidade por classe&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
